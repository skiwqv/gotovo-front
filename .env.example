# Скопируйте в .env (локально) и задайте те же переменные в Cloudflare Pages → Settings → Variables.
# При `nuxt generate` значения подставляются на этапе сборки.

# Адрес сайта: канонические ссылки, hreflang, og:image.
# Пусто — берётся CF_PAGES_URL (Cloudflare задаёт сам), локально — http://localhost:3000
NUXT_PUBLIC_SITE_URL=

# Индексация поисковиками. Всё, кроме true, — noindex (превью на pages.dev не должно попасть в поиск)
NUXT_PUBLIC_INDEXABLE=

# Supabase → Project Settings → API Keys. Только publishable/anon ключ: он публичный, данные защищает RLS.
# secret/service_role ключ сюда НЕ класть никогда.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
